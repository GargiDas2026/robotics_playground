<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============================= -->
    <!-- Robot Dimensions              -->
    <!-- ============================= -->

    <xacro:property name="link1_length" value="1.0"/>
    <xacro:property name="link2_length" value="0.8"/>

    <xacro:property name="link_radius" value="0.04"/>
    <xacro:property name="base_radius" value="0.08"/>
    <xacro:property name="base_length" value="0.05"/>

    <!-- Robot Colors -->

    <xacro:property name="base_color" value="0.25 0.25 0.25 1"/>
    <xacro:property name="link1_color" value="0.0 0.45 0.74 1"/>
    <xacro:property name="link2_color" value="0.85 0.33 0.10 1"/>
    <xacro:property name="ee_color" value="0.93 0.69 0.13 1"/>

</robot>