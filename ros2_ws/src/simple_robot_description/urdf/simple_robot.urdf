<?xml version="1.0"?>

<robot name="simple_robot">

  <!-- Base -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>

      <origin xyz="0 0 0"/>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

    </visual>

  </link>


  <!-- Link -->

  <link name="link1">

    <visual>

      <origin xyz="0 0 0.25" rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.03" length="0.5"/>
      </geometry>

      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>

    </visual>

  </link>


  <!-- Joint -->

  <joint name="joint1" type="fixed">

    <parent link="base_link"/>

    <child link="link1"/>

    <origin xyz="0 0 0.05"/>

  </joint>

</robot>