<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========================================================= -->
    <!-- Revolute Joint Macro                                      -->
    <!-- ========================================================= -->

    <xacro:macro
        name="revolute_joint"

        params="
            name
            parent_link
            child_link
            xyz
            rpy
            axis
            lower
            upper
            effort
            velocity">

        <joint name="${name}" type="revolute">

            <!-- Parent and Child Links -->

            <parent link="${parent_link}"/>
            <child link="${child_link}"/>

            <!-- Joint Frame -->

            <origin
                xyz="${xyz}"
                rpy="${rpy}"/>

            <!-- Joint Axis -->

            <axis xyz="${axis}"/>

            <!-- Joint Limits -->

            <limit
                lower="${lower}"
                upper="${upper}"
                effort="${effort}"
                velocity="${velocity}"/>

        </joint>

    </xacro:macro>

    <!-- ========================================================= -->
    <!-- Fixed Joint Macro                                         -->
    <!-- ========================================================= -->

    <xacro:macro
        name="fixed_joint"
        params="
            name
            parent_link
            child_link
            xyz
            rpy">

        <joint
            name="${name}"
            type="fixed">

            <!-- Parent and Child Links -->

            <parent link="${parent_link}"/>
            <child link="${child_link}"/>

            <!-- Joint / Frame Origin -->

            <origin
                xyz="${xyz}"
                rpy="${rpy}"/>

        </joint>

    </xacro:macro>


    <!-- ========================================================= -->
    <!-- Joint 1                                                   -->
    <!-- ========================================================= -->

    <xacro:revolute_joint

        name="joint1"

        parent_link="base_link"

        child_link="link1"

        xyz="0 0 0"

        rpy="0 0 0"

        axis="0 0 1"

        lower="-3.14159265"

        upper="3.14159265"

        effort="50"

        velocity="2.0"/>


    <!-- ========================================================= -->
    <!-- Joint 2                                                   -->
    <!-- ========================================================= -->

    <xacro:revolute_joint

        name="joint2"

        parent_link="link1"

        child_link="link2"

        xyz="${link1_length} 0 0"

        rpy="0 0 0"

        axis="0 0 1"

        lower="-3.14159265"

        upper="3.14159265"

        effort="50"

        velocity="2.0"/>

        
    <!-- ========================================================= -->
    <!-- End Effector Fixed Joint                                  -->
    <!-- Connects link2 to ee_link                                 -->
    <!-- ========================================================= -->

    <xacro:fixed_joint

        name="ee_fixed_joint"

        parent_link="link2"

        child_link="ee_link"

        xyz="${link2_length} 0 0"

        rpy="0 0 0"/>

</robot>